{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "Preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "target": "ESNext",
    "types": [
      "bun"
    ],
    "skipLibCheck": true
  },
  "include": [
    "scripts",
    "tests"
  ]
}
